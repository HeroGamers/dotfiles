{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "╭─",
          "background": "p:accent",
          "foreground": "p:base",
          "template": " {{ .Icon }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:surface0",
          "foreground": "p:accent",
          "template": "{{ if or .SSHSession .Root }} {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:surface1",
          "foreground": "p:text",
          "template": "  <b>{{ .Path }}</b> ",
          "options": { "style": "agnoster_short" }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:surface0",
          "foreground": "p:subtext1",
          "foreground_templates": ["{{ if or .Staging.Changed .Working.Changed }}p:peach{{ end }}"],
          "template": " {{ .HEAD }}{{ if .Staging.Changed }} +{{ end }}{{ if .Working.Changed }} *{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }} ",
          "options": { "fetch_status": true }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "templates_logic": "first_match",
          "templates": [
            "{{ with .Env.NIX_SHELL_WRAPPER_DESCRIPTIONS }}   {{ . }}{{ end }}",
            "{{ with .Env.IN_NIX_SHELL }}   {{ . }}{{ end }}",
            "{{ if and .Env.DIRENV_FILE (not .Env.VIRTUAL_ENV) }}  direnv{{ end }}"
          ]
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:subtext1",
          "template": "{{ with .Env.VIRTUAL_ENV }}  ({{ base . }}){{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "─╮",
          "background": "p:surface0",
          "foreground": "p:subtext1",
          "template": " {{ .CurrentDate | date .Format }}  ",
          "options": { "time_format": "15:04" }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "template": "╰─"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:subtext1",
          "template": " {{ .FormattedMs }} ",
          "options": { "threshold": 3000, "style": "round" }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:accent",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": "{{ if gt .Code 0 }} {{ .Code }} {{ end }}❯ ",
          "options": { "always_enabled": true }
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:accent",
    "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
    "template": "❯ "
  }
}
